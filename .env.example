# OpenAI API key (required)
OPENAI_API_KEY=sk-your-key-here

# Google GenAI API key (required only when USE_GEMINI_FOR_ORGANS=true)
GOOGLE_GENAI_API_KEY=

# App branding (optional — defaults to EcoLiveNatal)
NEXT_PUBLIC_APP_TITLE=EcoLiveNatal

# Clinic white-labeling (optional)
NEXT_PUBLIC_CLINIC_NAME=
NEXT_PUBLIC_CLINIC_LOGO_URL=

# Upstash Redis — required for token auth and daily usage tracking
# Create a free database at https://upstash.com and copy the REST credentials
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Landing page — public-facing site
NEXT_PUBLIC_WHATSAPP_NUMBER=   # WhatsApp number for access requests (e.g. +5491112345678)

# Optional features
MOCK_API=                      # Set to "true" to skip OpenAI and return a mock image
ENABLE_SESSION_IMAGE_CACHE=    # Set to "true" to cache identical generation requests
ENABLE_VISION_ANALYSIS=        # Set to "true" to analyze ultrasound structure before prompt assembly
USE_GEMINI_FOR_ORGANS=         # Set to "true" to route non-face anatomical renders through Gemini

# Internal observability
INTERNAL_METRICS_TOKEN=        # Bearer token required by /api/internal/generation-telemetry
