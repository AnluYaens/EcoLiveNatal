# OpenAI API key (required)
OPENAI_API_KEY=sk-your-key-here

# Google GenAI API key (required only when USE_GEMINI_FOR_ORGANS=true)
GOOGLE_GENAI_API_KEY=

# App branding (optional — defaults to EcoLiveNatal)
NEXT_PUBLIC_APP_TITLE=EcoLiveNatal

# Clinic white-labeling (optional)
NEXT_PUBLIC_CLINIC_NAME=
NEXT_PUBLIC_CLINIC_LOGO_URL=

# Upstash Redis — required for token auth and daily usage tracking
# Create a free database at https://upstash.com and copy the REST credentials
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Landing page — public-facing site
NEXT_PUBLIC_WHATSAPP_NUMBER=   # WhatsApp number for access requests (e.g. +5491112345678)

# Optional features
MOCK_API=                      # Set to "true" to skip OpenAI and return a mock image
ENABLE_SESSION_IMAGE_CACHE=    # Set to "true" to cache identical generation requests
ENABLE_VISION_ANALYSIS=false   # Default/recommended "false". Set to "true" only for difficult images, debugging, or strict-fidelity evaluation.
IMAGE_PROVIDER_STRATEGY=openai_all # Recommended GPT Image 2 path. Use dual or gemini_organs for Gemini rollback/fallback.
OPENAI_IMAGE_TIMEOUT_MS=120000 # OpenAI image edit timeout in ms. Default 120000; allowed range 60000-300000.
USE_GEMINI_FOR_ORGANS=         # Set to "true" to route non-face anatomical renders through Gemini

# Internal observability
INTERNAL_METRICS_TOKEN=        # Bearer token required by /api/internal/generation-telemetry

# Provider/model flags
OPENAI_PORTRAIT_MODEL=gpt-image-2   # Recommended/default OpenAI portrait model. Override only for rollback/evaluation.
OPENAI_ANATOMICAL_MODEL=gpt-image-2 # Recommended/default anatomical model when IMAGE_PROVIDER_STRATEGY=openai_all.

# Legacy diagnostic flags (see docs/diagnosis_2026_04.md)
# USE_SHORT_PROMPTS is deprecated in Phase 8 and no longer changes GPT Image 2 prompt routing.
SKIP_IMAGE_PREPROCESS=false    # Recommended "false". Set to "true" only to bypass preprocessUltrasound/stripYellowOverlay/heart preprocess.
